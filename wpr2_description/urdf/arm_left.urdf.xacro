<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <material name="TransparentGreen">
    <color rgba="0.0 1.0 0.0 0.5"/>
  </material>
  <xacro:macro name="arm_left" params="base_frame x y z roll pitch yaw">
    <!-- joint 0 -->
    <link name="left_link_0">
    </link>
    <joint name="left_joint_0" type="fixed">
      <parent link="${base_frame}"/>
      <child link="left_link_0"/>
      <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
    </joint>

    <!-- joint 1 -->
    <link name="left_link_1">
      <visual>
        <geometry>
          <mesh filename="package://wpr2_description/meshes/arm/arm_link_1.dae" scale="1 1 1"/>
        </geometry>
        <origin rpy="${-M_PI*0.5} 0 ${M_PI*0.5}" xyz="0 -0.07 0"/>
      </visual>
      <collision>
        <origin xyz="0.09 0 0" rpy="0 ${M_PI*0.5} 0"/>
        <geometry>
          <cylinder length="0.07" radius="0.041"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.01"/>
      </inertial>
    </link>
    <joint name="left_joint_1" type="continuous">
      <parent link="left_link_0"/>
      <child link="left_link_1"/>
      <origin xyz="0.0 0 0.0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <!-- joint 2 -->
    <link name="left_link_2">
      <visual>
        <geometry>
          <mesh filename="package://wpr2_description/meshes/arm/arm_link_2.dae" scale="1 1 1"/>
        </geometry>
        <origin rpy="${M_PI} ${M_PI} 0" xyz="0 0 0"/>
      </visual>
      <collision>
        <origin xyz="0 0.05 0 " rpy="${-M_PI*0.5} 0 0"/>
        <geometry>
          <cylinder length="0.18" radius="0.041"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.01"/>
      </inertial>
    </link>
    <joint name="left_joint_2" type="continuous">
      <parent link="left_link_1"/>
      <child link="left_link_2"/>
      <origin xyz="0 0 0 " rpy="0 ${M_PI} 0"/>
      <axis xyz="1 0 0"/>
    </joint>

    <!-- joint 3 -->
    <link name="left_link_3">
      <visual>
        <geometry>
          <mesh filename="package://wpr2_description/meshes/arm/arm_link_3.dae" scale="1 1 1"/>
        </geometry>
        <origin xyz="0 0.19 0" rpy="${-M_PI*0.5} 0 ${-M_PI*0.5}" />
      </visual>
      <collision>
        <origin xyz="0 0.19 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.12" radius="0.041"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.01"/>
      </inertial>
    </link>
    <joint name="left_joint_3" type="continuous">
      <parent link="left_link_2"/>
      <child link="left_link_3"/>
      <origin xyz="0 0 0 " rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <!-- joint 4 -->
    <link name="left_link_4">
      <visual>
        <geometry>
          <mesh filename="package://wpr2_description/meshes/arm/arm_link_4.dae" scale="1 1 1"/>
        </geometry>
        <origin rpy="${M_PI*0.5} ${M_PI*0.5} 0" xyz="0 0 0.051"/>
      </visual>
      <collision>
        <origin xyz="0 0.09 0" rpy="${M_PI*0.5}  0 0"/>
        <geometry>
          <cylinder length="0.07" radius="0.041"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.01"/>
      </inertial>
    </link>
    <joint name="left_joint_4" type="continuous">
      <parent link="left_link_3"/>
      <child link="left_link_4"/>
      <origin xyz="0 0.19 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <!-- joint 5 -->
    <link name="left_link_5">
      <visual>
        <geometry>
          <mesh filename="package://wpr2_description/meshes/arm/arm_link_5.dae" scale="1 1 1"/>
        </geometry>
        <origin rpy="${-M_PI*0.5} 0 ${-M_PI*0.5}" xyz="0 0 0"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.12" radius="0.041"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.01"/>
      </inertial>
    </link>
    <joint name="left_joint_5" type="continuous">
      <parent link="left_link_4"/>
      <child link="left_link_5"/>
      <origin xyz="0 0.17 0" rpy="0 ${M_PI*0.5} 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <!-- joint 6 -->
    <link name="left_link_6">
      <visual>
        <geometry>
          <mesh filename="package://wpr2_description/meshes/arm/arm_link_wrist.dae" scale="1 1 1"/>
        </geometry>
        <origin rpy="${-M_PI*0.5} ${M_PI*0.5}  0" xyz="0 0 0.05"/>
      </visual>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.01"/>
      </inertial>
    </link>
    <joint name="left_joint_6" type="continuous">
      <parent link="left_link_5"/>
      <child link="left_link_6"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="left_link_knuckle_1">
      <visual>
        <geometry>
          <mesh filename="package://wpr2_description/meshes/arm/arm_link_knuckle.dae" scale="1 1 1"/>
        </geometry>
        <origin rpy="${-M_PI*0.5} ${M_PI*0.5} 0" xyz="0 0 0"/>
      </visual>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.01"/>
      </inertial>
    </link>
    <joint name="left_joint_finger" type="revolute">
      <parent link="left_link_6"/>
      <child link="left_link_knuckle_1"/>
      <origin xyz="0.005 0.11 0" rpy="0 0 0"/>
      <axis xyz="0 0 -1"/>
      <limit effort="1000.0" lower="0" upper="1.57" velocity="0.5"/>
    </joint>

    <link name="left_link_tip_1">
      <visual>
        <geometry>
          <mesh filename="package://wpr2_description/meshes/arm/arm_link_tip.dae" scale="1 1 1"/>
        </geometry>
        <origin rpy="${-M_PI*0.5} ${M_PI*0.5} 0" xyz="0 0 0"/>
      </visual>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.01"/>
      </inertial>
    </link>
    <joint name="left_joint_tip_1" type="revolute">
      <parent link="left_link_knuckle_1"/>
      <child link="left_link_tip_1"/>
      <origin xyz="0 0.095 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="1000.0" lower="0" upper="1.57" velocity="0.5"/>
      <mimic joint="left_joint_finger" multiplier="1" offset="0"/>
    </joint>

    <link name="left_link_knuckle_2">
      <visual>
        <geometry>
          <mesh filename="package://wpr2_description/meshes/arm/arm_link_knuckle.dae" scale="1 1 1"/>
        </geometry>
        <origin rpy="${-M_PI*0.5} ${-M_PI*0.5} 0" xyz="0 0 0"/>
      </visual>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.01"/>
      </inertial>
    </link>
    <joint name="left_joint_finger_2" type="revolute">
      <parent link="left_link_6"/>
      <child link="left_link_knuckle_2"/>
      <origin xyz="-0.005 0.11 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="1000.0" lower="0" upper="1.57" velocity="0.5"/>
      <mimic joint="left_joint_finger" multiplier="1" offset="0"/>
    </joint>

    <link name="left_link_tip_2">
      <visual>
        <geometry>
          <mesh filename="package://wpr2_description/meshes/arm/arm_link_tip.dae" scale="1 1 1"/>
        </geometry>
        <origin rpy="${-M_PI*0.5} ${M_PI*0.5} 0" xyz="0 0 0"/>
      </visual>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.01"/>
      </inertial>
    </link>
    <joint name="left_joint_tip_2" type="revolute">
      <parent link="left_link_knuckle_2"/>
      <child link="left_link_tip_2"/>
      <origin xyz="0 0.095 0" rpy="0 0 0"/>
      <axis xyz="0 0 -1"/>
      <limit effort="1000.0" lower="0" upper="1.57" velocity="0.5"/>
      <mimic joint="left_joint_finger" multiplier="1" offset="0"/>
    </joint>

    <!-- TCP(Tool Center Point) -->
    <link name="left_tcp_link">
      <inertial>
        <mass value="0.001" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
      </inertial>
      <!-- 手爪根部 -->
      <collision>
        <origin rpy = "0 0 0" xyz = "0.0 -0.13 0.0"/>
        <geometry>
            <box size="0.08 0.05 0.1"/>
        </geometry>
      </collision>
       <!-- 手指活动范围 -->
      <collision>
        <origin rpy = "0 0 0" xyz = "0.0 -0.028 0.0"/>
        <geometry>
            <box size="0.18 0.15 0.04"/>
        </geometry>
      </collision>
    </link>

    <joint name="left_tcp_joint" type="fixed">
      <parent link="left_link_6" />
      <child link="left_tcp_link" />
      <origin xyz="0 0.2 0" rpy="0 0 0" /> 
    </joint>
  </xacro:macro>
</robot>
