<?xml version="1.0"?>
<package format="3">
  <name>wpr2_behaviors</name>
  <version>0.1.0</version>
  <description>WPR2 point-cloud object detection and feedback-driven right-arm grasp behavior.</description>
  <maintainer email="zhangwanjie@6-robot.com">ZhangWanjie</maintainer>
  <license>BSD-3-Clause</license>
  <url type="website">http://www.6-robot.com</url>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>wpr2_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>wpr2_bringup</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>python3-yaml</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
