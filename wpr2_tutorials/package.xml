<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wpr2_tutorials</name>
  <version>0.0.0</version>
  <description>ROS 2 Humble experiments for WPR2</description>
  <maintainer email="zhangwanjie@6-robot.com">ZhangWanjie</maintainer>
  <license>BSD-3-Clause</license>
  <url type="website">http://www.6-robot.com</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>wpr2_msgs</depend>
  <depend>libopencv-dev</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>wpr2_bringup</exec_depend>
  <exec_depend>wpr2_description</exec_depend>
  <exec_depend>wpr2_behaviors</exec_depend>
  <exec_depend>wp_map_tools</exec_depend>
  <exec_depend>wp_speech</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>nav2_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
