    Enabled: true
    Links:
      All Links Enabled: true
      Expand Tree: false
    Mass Properties:
      Inertia: false
      Mass: false
    Name: RobotModel
    TF Prefix: ''
    Update Interval: 0
    Value: true
    Visual Enabled: true
